# frozen_string_literal: true

source 'https://rubygems.org'

gemspec

# Drives the dummy app in a browser for the system specs.
gem 'capybara'
# Drives Chromium for the system specs, through Playwright's own API.
gem 'playwright-ruby-client'
# Serves the dummy app to the browser.
gem 'puma'
# Boots the dummy app the specs install into.
gem 'rails'
# Runs the gem's own tasks.
gem 'rake'
# Finds code smells RuboCop doesn't.
gem 'reek'
# The test framework.
gem 'rspec-rails'
# Lints the gem and its specs.
gem 'rubocop'
# Lints the Capybara calls in the system specs.
gem 'rubocop-capybara'
# Flags slow Ruby idioms.
gem 'rubocop-performance'
# Lints the rake task.
gem 'rubocop-rake'
# Lints the specs.
gem 'rubocop-rspec'
# Lints the Rails-specific parts of the specs.
gem 'rubocop-rspec_rails'
